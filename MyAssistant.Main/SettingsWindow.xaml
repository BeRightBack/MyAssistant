<Window x:Class="MyAssistant.Main.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyAssistant Settings"
        Height="720" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#FF0D1117"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF161B22" BorderBrush="#FF21262D" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="#FFC9D1D9"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- Active Provider -->
                <TextBlock Text="ACTIVE PROVIDER" FontSize="11" FontWeight="SemiBold" Foreground="#FF9EA7B3"
                           Margin="0,0,0,8"/>
                <Border Background="#FF161B22" CornerRadius="8" Padding="16" BorderBrush="#FF21262D" BorderThickness="1" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Select which provider to use. Also changeable from the sidebar." FontSize="11"
                                   Foreground="#FF7D8590" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="ActiveProviderCombo" Width="300" HorizontalAlignment="Left"/>
                            <Button x:Name="AddProviderBtn" Content="Add" Height="30" Margin="12,0,0,0" Click="AddProvider_Click"
                                    Background="#FF238636" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                    BorderThickness="0" Padding="12,0" ToolTip="Add new provider"/>
                            <Button x:Name="DeleteProviderBtn" Content="Remove" Height="30" Margin="6,0,0,0" Click="DeleteProvider_Click"
                                    Background="#FFda3633" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                    BorderThickness="0" Padding="12,0" ToolTip="Delete selected provider"/>
                            <TextBlock x:Name="DetectedKind" Text="" FontSize="11" Foreground="#FF58A6FF"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Provider Settings -->
                <TextBlock Text="PROVIDER CONFIGURATION" FontSize="11" FontWeight="SemiBold" Foreground="#FF9EA7B3"
                           Margin="0,0,0,8"/>

                <Border Background="#FF161B22" CornerRadius="8" Padding="20" BorderBrush="#FF21262D" BorderThickness="1" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Display Name" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <TextBox x:Name="ProviderName" Width="250" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Provider Kind (auto-detected)" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <TextBlock x:Name="ProviderKindLabel" Text="Auto" FontSize="12" Foreground="#FF58A6FF"
                                           VerticalAlignment="Center" MinHeight="30"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                <TextBlock Text="Base URL" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <TextBox x:Name="BaseUrl" Width="580" HorizontalAlignment="Left"
                                         TextChanged="BaseUrl_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                                <TextBlock Text="API Key" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <Grid>
                                    <TextBox x:Name="ApiKey" Width="500" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Required for cloud providers. Not needed for local Ollama."
                                               FontSize="10" Foreground="#FF7D8590" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
                                <TextBlock Text="Model" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ModelCombo" Grid.Column="0" Width="350" HorizontalAlignment="Left"
                                              SelectionChanged="ModelCombo_SelectionChanged"/>
                                    <Button Grid.Column="1" Content="Refresh" FontFamily="Segoe UI"
                                            Click="RefreshModels_Click" Padding="10,5" Margin="10,0,0,0"
                                            FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock x:Name="ModelHint" Text="Pick from available models, or type a custom model ID"
                                           FontSize="10" Foreground="#FF7D8590" Margin="0,4,0,0"/>
                                <TextBox x:Name="DefaultModel" Width="350" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                <TextBlock Text="Or type a model ID directly above" FontSize="10" Foreground="#FF7D8590" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="8" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Temperature" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                    <TextBox x:Name="Temperature" Width="120"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Top P" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TopP" Width="120"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Max Tokens" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MaxTokens" Width="120"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Test Connection -->
                        <Separator Background="#FF21262D" Margin="0,16,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test Connection" Click="TestConnection_Click" Padding="14,7"
                                    FontSize="12" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="ConnectionStatus" Text="" FontSize="11" Margin="12,0,0,0"
                                       Foreground="#FF9EA7B3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Agent Settings -->
                <TextBlock Text="ASSISTANT ROLE" FontSize="11" FontWeight="SemiBold" Foreground="#FF9EA7B3"
                           Margin="0,0,0,8"/>
                <Border Background="#FF161B22" CornerRadius="8" Padding="20" BorderBrush="#FF21262D" BorderThickness="1" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Select a role to change the assistant's personality. All tools remain available."
                                   FontSize="11" Foreground="#FF7D8590" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active Role:" FontSize="11" Foreground="#FF9EA7B3"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="RoleCombo" Width="250" SelectionChanged="RoleCombo_SelectionChanged"/>
                        </StackPanel>

                        <Separator Background="#FF21262D" Margin="0,16,0,16"/>

                        <StackPanel>
                            <TextBlock Text="Role Name" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                            <TextBox x:Name="RoleName" Width="300" HorizontalAlignment="Left"/>

                            <TextBlock Text="Description" FontSize="11" Foreground="#FF9EA7B3" Margin="0,8,0,4"/>
                            <TextBox x:Name="RoleDescription" Width="600" HorizontalAlignment="Left"/>

                            <TextBlock Text="System Prompt" FontSize="11" Foreground="#FF9EA7B3" Margin="0,8,0,4"/>
                            <TextBox x:Name="RoleSystemPrompt" Width="640" Height="180"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     FontFamily="Consolas, Cascadia Code" FontSize="12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Save Role" Click="SaveRole_Click" Padding="14,7"
                                        FontSize="12" HorizontalAlignment="Left"/>
                                <Button Content="Delete Role" Click="DeleteRole_Click" Padding="14,7"
                                        FontSize="12" HorizontalAlignment="Left" Margin="8,0,0,0">
                                    <Button.Foreground>
                                        <SolidColorBrush Color="#FFDA3633"/>
                                    </Button.Foreground>
                                </Button>
                                <TextBlock x:Name="RoleStatus" Text="" FontSize="11" Margin="12,0,0,0"
                                           Foreground="#FF9EA7B3" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Agent Settings -->
                <TextBlock Text="AGENT SETTINGS" FontSize="11" FontWeight="SemiBold" Foreground="#FF9EA7B3"
                           Margin="0,0,0,8"/>
                <Border Background="#FF161B22" CornerRadius="8" Padding="20" BorderBrush="#FF21262D" BorderThickness="1" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Max tool iterations per message:" FontSize="11" Foreground="#FF9EA7B3"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="MaxIterations" Width="60"/>
                            <TextBlock Text="(prevents infinite loops)" FontSize="10" Foreground="#FF7D8590"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Max context messages:" FontSize="11" Foreground="#FF9EA7B3"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="MaxContextMessages" Width="60"/>
                            <TextBlock Text="(sliding window, 0=unlimited)" FontSize="10" Foreground="#FF7D8590"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Workspace root:" FontSize="11" Foreground="#FF9EA7B3"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="WorkspaceRootBox" Width="420"/>
                            <Button Content="Browse..." Click="BrowseWorkspace_Click" Padding="10,4" Margin="8,0,0,0" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Text="Directory the assistant operates in: file tools, shell commands and project scanning resolve here. Leave empty to auto-detect."
                                   FontSize="10" Foreground="#FF7D8590" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- UI Settings -->
                <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold" Foreground="#FF9EA7B3"
                           Margin="0,0,0,8"/>
                <Border Background="#FF161B22" CornerRadius="8" Padding="20" BorderBrush="#FF21262D" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Code Font Size" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <TextBox x:Name="FontSizeBox" Width="80"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Font Family" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <TextBox x:Name="FontFamilyBox" Width="200"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Database Settings -->
                <TextBlock Text="DATABASE" FontSize="11" FontWeight="SemiBold" Foreground="#FF9EA7B3"
                           Margin="0,0,0,8"/>
                <Border Background="#FF161B22" CornerRadius="8" Padding="20" BorderBrush="#FF21262D" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="MySQL connection settings. Changes require app restart."
                                   FontSize="11" Foreground="#FF7D8590" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Host" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <TextBox x:Name="DbHost" Width="300" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Port" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <TextBox x:Name="DbPort" Width="100" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Database Name" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <TextBox x:Name="DbName" Width="300" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="Username" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <TextBox x:Name="DbUser" Width="300" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="Password" FontSize="11" Foreground="#FF9EA7B3" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="DbPassword" Width="100" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#FF21262D" Margin="0,16,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test Connection" Click="TestDbConnection_Click" Padding="14,7"
                                    FontSize="12" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="DbConnectionStatus" Text="" FontSize="11" Margin="12,0,0,0"
                                       Foreground="#FF9EA7B3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tools -->
                <TextBlock Text="TOOLS" FontSize="11" FontWeight="SemiBold" Foreground="#FF9EA7B3"
                           Margin="0,0,0,8"/>
                <Border Background="#FF161B22" CornerRadius="8" Padding="20" BorderBrush="#FF21262D" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Enable or disable individual tools. Disabled tools won't be available to the model."
                                   FontSize="11" Foreground="#FF7D8590" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="ToolsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF0D1117" CornerRadius="6" Padding="12,8" Margin="0,4"
                                            BorderBrush="#FF21262D" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#FFC9D1D9"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10"
                                                           Foreground="#FF7D8590" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="450"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FF161B22" BorderBrush="#FF21262D" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <TextBlock Text="Changes apply on next message" FontSize="10"
                           Foreground="#FF7D8590" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0" FontSize="12"/>
                    <Button Content="Save" Click="Save_Click" Padding="16,8" FontSize="12">
                        <Button.Background>
                            <SolidColorBrush Color="#FF238636"/>
                        </Button.Background>
                        <Button.Foreground>
                            <SolidColorBrush Color="White"/>
                        </Button.Foreground>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
