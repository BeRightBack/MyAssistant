<Window x:Class="MyAssistant.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyAssistant.Main"
        mc:Ignorable="d"
        Title="MyAssistant"
        Height="850" Width="1300"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#FF0D1117"
        FontFamily="Segoe UI, Consolas">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#FF161B22" BorderBrush="#FF21262D" BorderThickness="0,0,0,1">
            <Grid Height="44" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF58A6FF" Offset="0"/>
                                <GradientStop Color="#FFBC8CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="M" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MyAssistant" FontSize="15" FontWeight="SemiBold" Foreground="#FFC9D1D9"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Background="#FF21262D" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#FF3FB950" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ProviderStatus}" FontSize="11" Foreground="#FF9EA7B3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Session Title -->
                <TextBlock Grid.Column="1" Text="{Binding SessionTitle}" FontSize="13"
                           Foreground="#FF9EA7B3" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Right: Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TokenUsage}" FontSize="11" Foreground="#FF7D8590"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Width="30" Height="30" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="New Chat"
                            Command="{Binding NewSessionCommand}">
                        <TextBlock Text="+" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                                   Foreground="#FF9EA7B3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="30" Height="30" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="Settings"
                            Click="Settings_Click" x:Name="SettingsButton"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#FF0D1117" BorderBrush="#FF21262D" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <StackPanel Grid.Row="0" Margin="16,16,16,12">
                        <TextBlock Text="Sessions" FontSize="12" FontWeight="SemiBold" Foreground="#FF9EA7B3" Margin="0,0,0,8"/>
                        <Border Background="#FF161B22" CornerRadius="6" Padding="8,6" Cursor="Hand"
                                MouseLeftButtonDown="NewSession_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                           Foreground="#FF58A6FF" VerticalAlignment="Center"/>
                                <TextBlock Text="New Chat" FontSize="12" Foreground="#FFC9D1D9" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Search Box -->
                        <Border Background="#FF0D1117" CornerRadius="6" Padding="8,4" Margin="0,8,0,0"
                                BorderBrush="#FF21262D" BorderThickness="1">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="11"
                                     Foreground="#FFC9D1D9" Padding="2,2"
                                     local:TextBoxBehavior.EnterKeyCommand="{Binding SendCommand}"/>
                        </Border>
                    </StackPanel>

                    <!-- Session List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,0">
                        <ItemsControl ItemsSource="{Binding FilteredSessions}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,8" Margin="4,2"
                                            Background="{Binding IsSelected, Converter={StaticResource BoolToSurfaceConverter}}">
                                        <Grid Cursor="Hand" MouseLeftButtonDown="SessionItem_Click">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Rename" Click="RenameSession_Click" Tag="{Binding Id}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete" Click="DeleteSessionMenu_Click" Tag="{Binding Id}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#FFC9D1D9"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TimeAgo}" FontSize="10" Foreground="#FF7D8590"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="20" Height="20" CornerRadius="4"
                                                    Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                                    MouseLeftButtonDown="DeleteSession_Click" ToolTip="Delete chat"
                                                    Tag="{Binding Id}">
                                                <TextBlock Text="×" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                                                           Foreground="#FF7D8590" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Sidebar Footer: Provider + Model + Settings -->
                    <Border Grid.Row="3" Background="#FF161B22" BorderBrush="#FF21262D"
                            BorderThickness="0,1,0,0" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Provider -->
                            <TextBlock Grid.Row="0" Text="Provider" FontSize="10" Foreground="#FF7D8590"/>
                            <ComboBox Grid.Row="2" x:Name="ProviderSelector" Width="230"
                                      SelectedItem="{Binding ActiveProviderName}"
                                      SelectionChanged="ProviderSelector_SelectionChanged"/>

                            <!-- Model -->
                            <TextBlock Grid.Row="4" Text="Model" FontSize="10" Foreground="#FF7D8590"/>
                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="ModelSelector" Width="195"
                                          SelectedItem="{Binding SelectedModel}"
                                          SelectionChanged="ModelSelector_SelectionChanged"
                                          Margin="0,0,4,0"/>
                                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4"
                                        Background="#FF21262D" Cursor="Hand" ToolTip="Refresh models"
                                        MouseLeftButtonDown="RefreshModels_Click">
                                    <TextBlock Text="↻" FontFamily="Segoe UI" FontSize="12"
                                               Foreground="#FF58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- API Key Status -->
                            <Border Grid.Row="8" Background="#FF0D1117" CornerRadius="4" Padding="8,5"
                                    Cursor="Hand" MouseLeftButtonDown="StatusBarSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding ApiKeyStatusColor}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ApiKeyStatusText}" FontSize="10" Foreground="#FF9EA7B3"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ToolCount}" FontSize="10" Foreground="#FF7D8590"/>
                                <Border Grid.Column="1" Width="22" Height="22" CornerRadius="4"
                                        Background="#FF21262D" Cursor="Hand" ToolTip="Export chat as Markdown"
                                        MouseLeftButtonDown="ExportChat_Click">
                                    <TextBlock Text="&#x21E9;" FontFamily="Segoe UI" FontSize="10"
                                               Foreground="#FF58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Theme Toggle -->
                            <Grid Grid.Row="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Theme" FontSize="10" Foreground="#FF7D8590" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8,3" Cursor="Hand"
                                        Background="#FF21262D" MouseLeftButtonDown="ThemeToggle_Click"
                                        ToolTip="Toggle dark/light theme">
                                    <TextBlock x:Name="ThemeLabel" Text="Dark" FontSize="10" Foreground="#FFC9D1D9"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Chat Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFFF4444" Padding="16,10" CornerRadius="0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚠" FontFamily="Segoe UI Symbol" FontSize="14"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="12"
                                   Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Border Grid.Column="2" Width="24" Height="24" CornerRadius="12"
                                Background="#66FFFFFF" Cursor="Hand" MouseLeftButtonDown="ClearError_Click"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="×" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Messages -->
                <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="#FF0D1117">
                    <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}" Margin="20,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,24" ClipToBounds="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                            VerticalAlignment="Top" Margin="6,4,6,0" ClipToBounds="False">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Role, Converter={StaticResource RoleToColorConverter}}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Role, Converter={StaticResource RoleToIconConverter}}"
                                                   FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1">
                                        <!-- Header -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding RoleName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#FFC9D1D9"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='  HH:mm'}"
                                                       FontSize="11" Foreground="#FF7D8590" VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Usage}" FontSize="10" Foreground="#FF7D8590"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <!-- Copy -->
                                            <Border Width="20" Height="20" CornerRadius="4" Margin="8,0,0,0"
                                                    Background="Transparent" Cursor="Hand" ToolTip="Copy message"
                                                    MouseLeftButtonDown="CopyMessage_Click" Tag="{Binding Content}">
                                                <TextBlock Text="&#x2398;" FontFamily="Segoe UI" FontSize="10"
                                                           Foreground="#FF7D8590" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Edit (user messages only, hidden during edit mode) -->
                                            <Border Width="20" Height="20" CornerRadius="4" Margin="4,0,0,0"
                                                    Background="Transparent" Cursor="Hand" ToolTip="Edit &amp; resend"
                                                    MouseLeftButtonDown="EditMessage_Click" DataContext="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsUser}" Value="True"/>
                                                                    <Condition Binding="{Binding IsEditing}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#x270E;" FontFamily="Segoe UI" FontSize="10"
                                                           Foreground="#FF7D8590" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Regenerate (assistant messages only, hidden during edit mode) -->
                                            <Border Width="20" Height="20" CornerRadius="4" Margin="4,0,0,0"
                                                    Background="Transparent" Cursor="Hand" ToolTip="Regenerate"
                                                    MouseLeftButtonDown="RegenerateMessage_Click" DataContext="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsAssistant}" Value="True"/>
                                                                    <Condition Binding="{Binding IsEditing}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#x21BB;" FontFamily="Segoe UI" FontSize="10"
                                                           Foreground="#FF7D8590" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Thinking Section (collapsible, copyable) -->
                                        <Border Background="#FF0D1117" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                                BorderBrush="#FF21262D" BorderThickness="1" Cursor="Hand"
                                                MouseLeftButtonDown="ToggleThinking_Click" DataContext="{Binding}">
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThinking}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#x25B6;" FontFamily="Segoe UI" FontSize="9"
                                                                   Foreground="#FF7D8590" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </TextBlock.RenderTransform>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsThinkingExpanded}" Value="True">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="90"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="Thinking" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="#FF7D8590" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <FlowDocumentScrollViewer
                                                        Document="{Binding Thinking, Converter={StaticResource MarkdownConverter}}"
                                                        FontFamily="Consolas, Cascadia Code, Fira Code"
                                                        Background="Transparent" BorderThickness="0"
                                                        MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                                        HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                                                        <FlowDocumentScrollViewer.Style>
                                                            <Style TargetType="FlowDocumentScrollViewer">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThinkingExpanded}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </FlowDocumentScrollViewer.Style>
                                                    </FlowDocumentScrollViewer>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Message Body -->
                                        <Border Background="#FF161B22" CornerRadius="8" Padding="14,12"
                                                BorderBrush="#FF21262D" BorderThickness="1">
                                            <StackPanel>
                                                <!-- Rendered markdown (visible when not editing) -->
                                                <FlowDocumentScrollViewer Document="{Binding Content, Converter={StaticResource MarkdownConverter}}"
                                                            FontFamily="Consolas, Cascadia Code, Fira Code"
                                                            MaxHeight="400" VerticalScrollBarVisibility="Auto"
                                                            HorizontalScrollBarVisibility="Disabled"
                                                            Background="Transparent" BorderThickness="0">
                                                    <FlowDocumentScrollViewer.Style>
                                                        <Style TargetType="FlowDocumentScrollViewer">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </FlowDocumentScrollViewer.Style>
                                                </FlowDocumentScrollViewer>

                                                <!-- Edit TextBox (visible when editing) -->
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             FontFamily="Consolas, Cascadia Code, Fira Code"
                                                             FontSize="14" Foreground="#FFC9D1D9"
                                                             Background="#FF0D1117" BorderBrush="#FF58A6FF"
                                                             BorderThickness="1" Padding="8"
                                                             MaxHeight="400" VerticalScrollBarVisibility="Auto"
                                                             VerticalAlignment="Top" MinHeight="80"
                                                             KeyDown="EditTextBox_KeyDown"
                                                             Loaded="EditTextBox_Loaded"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom" Margin="0,8,0,0">
                                                        <Border Width="28" Height="28" CornerRadius="14" Margin="4,0"
                                                                Background="#FF238636" Cursor="Hand" ToolTip="Accept (Enter)"
                                                                MouseLeftButtonDown="AcceptEdit_Click">
                                                            <TextBlock Text="&#x2713;" FontFamily="Segoe UI" FontSize="13"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Width="28" Height="28" CornerRadius="14" Margin="4,0"
                                                                Background="#FFDA3633" Cursor="Hand" ToolTip="Cancel (Esc)"
                                                                MouseLeftButtonDown="CancelEdit_Click">
                                                            <TextBlock Text="&#x2715;" FontFamily="Segoe UI" FontSize="13"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Tool Calls -->
                                                <ItemsControl ItemsSource="{Binding ToolCalls}" Margin="0,12,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#FF0D1117" CornerRadius="6"
                                                                    Padding="10,8" Margin="0,4"
                                                                    BorderBrush="#FF21262D" BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                                               FontFamily="Segoe UI" FontSize="13"
                                                                               VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <TextBlock.Foreground>
                                                                            <SolidColorBrush Color="{Binding StatusColor}"/>
                                                                        </TextBlock.Foreground>
                                                                    </TextBlock>

                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                                       FontSize="12" Foreground="#FF58A6FF"/>
                                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                                       Foreground="#FF7D8590" Margin="8,0,0,0"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding ArgsPreview}" FontSize="11"
                                                                                   FontFamily="Consolas, monospace"
                                                                                   Foreground="#FF9EA7B3" Margin="0,2,0,0"
                                                                                   TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Processing Indicator -->
                <Border Grid.Row="1" VerticalAlignment="Top" Margin="68,16,20,0"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#FF58A6FF" Margin="0,0,8,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#FF9EA7B3"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="64" Height="64" CornerRadius="32" Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF58A6FF" Offset="0"/>
                                <GradientStop Color="#FFBC8CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="M" FontSize="28" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MyAssistant" FontSize="20" FontWeight="SemiBold" Foreground="#FFC9D1D9"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="AI Coding Assistant" FontSize="13" Foreground="#FF7D8590"
                               HorizontalAlignment="Center" Margin="0,4,0,20"/>
                    <TextBlock Text="Ask me anything about your code" FontSize="13" Foreground="#FF9EA7B3"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Press Enter to send, Shift+Enter for new line" FontSize="11"
                               Foreground="#FF7D8590" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Input Area -->
                <Border Grid.Row="2" Background="#FF161B22" BorderBrush="#FF21262D"
                        BorderThickness="0,1,0,0" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FF0D1117" CornerRadius="10"
                                BorderBrush="#FF21262D" BorderThickness="1" Padding="2">
                            <Grid>
                                <TextBox x:Name="InputTextBox"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Background="Transparent" Foreground="#FFC9D1D4"
                                         BorderThickness="0" Padding="14,12"
                                         FontFamily="Consolas, Cascadia Code, Fira Code"
                                         FontSize="13" AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxHeight="160" MinHeight="44"
                                         VerticalScrollBarVisibility="Auto"
                                         local:TextBoxBehavior.EnterKeyCommand="{Binding SendCommand}"
                                         local:TextBoxBehavior.ShiftEnterAddsNewLine="True"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="Message MyAssistant..." FontSize="13" Foreground="#FF7D8590"
                                           IsHitTestVisible="False" Padding="14,12"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InputText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                            <Button Command="{Binding CancelCommand}" Padding="8" Margin="0,0,4,0"
                                    Background="Transparent" Foreground="#FFF85149"
                                    BorderThickness="0" Cursor="Hand" ToolTip="Cancel"
                                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="×" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                           Foreground="#FFF85149" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Border Width="36" Height="36" CornerRadius="18" Cursor="Hand"
                                    Background="{Binding CanSend, Converter={StaticResource BoolToPrimaryConverter}}"
                                    MouseLeftButtonDown="Send_Click">
                                <TextBlock Text="▲" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FF161B22" BorderBrush="#FF21262D" BorderThickness="0,1,0,0"
                Height="28">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding ConnectionStatusColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusBarText}" FontSize="11" Foreground="#FF9EA7B3"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusBarCenter}" FontSize="11"
                           Foreground="#FF7D8590" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ToolCount}" FontSize="11" Foreground="#FF7D8590"
                               Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding SessionCount}" FontSize="11" Foreground="#FF7D8590"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>